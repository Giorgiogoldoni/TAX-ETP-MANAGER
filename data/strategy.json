{
  "schema_version": 1,
  "model_name": "Market-first dynamic model",
  "objective": "trend_momentum_relative_strength_risk",
  "currency": "EUR",
  "parameters": {
    "roc_period": 38,
    "moving_average_fast": 38,
    "moving_average_slow": 200,
    "ema_period": 20,
