      "trend": 30,
      "momentum": 25,
      "ao_ema": 15,
      "relative_strength": 20,
      "breadth": 10
    },
    "thresholds": {
      "strong": 70,
      "positive": 55,
      "neutral": 45,
      "weak": 30
    },
    "risk_flags": {
      "below_ma200": true,
      "negative_roc": true,
      "high_volatility": true
    }
  },
  "indicators": [
    "ROC38",
    "MA38",
    "MA200",
    "AO",
    "EMA20",
    "relative_strength",
    "market_breadth",
    "volatility",
    "drawdown"
  ],
  "notes": "Pesi iniziali configurabili. Calcolo incompleto se mancano dati; non costituisce segnale automatico di acquisto/vendita."
}
